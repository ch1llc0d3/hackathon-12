# The Docker-hosted agent service reads this key; the browser bridge never gets it.
# Create a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# Hermes is the default agent model. Override this only to use another
# OpenRouter model.
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-70b
# Used only when you explicitly capture and share a screenshot.
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional OpenRouter attribution URL for this app.
OPENROUTER_APP_URL=

# Comma-separated browser origins allowed to call the Docker-hosted agent APIs. The
# local demo is always allowed. The default is the production Marangatu origin.
ALLOWED_ORIGINS=https://marangatu.set.gov.py

# Used by `npm start`. Docker Compose supplies HOST=0.0.0.0 inside the
# container and publishes this port only on the host's loopback interface.
HOST=127.0.0.1
PORT=8787

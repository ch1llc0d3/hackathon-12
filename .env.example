# Ventanilla talks to any OpenAI-compatible chat-completions endpoint.
# Pick one and put a real key in a file called .env (which is gitignored).

# --- Google Gemini (free tier, no billing) ---
VENTANILLA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VENTANILLA_MODEL=gemini-2.0-flash
VENTANILLA_API_KEY=

# --- OpenRouter ---
# VENTANILLA_BASE_URL=https://openrouter.ai/api/v1
# VENTANILLA_MODEL=google/gemini-2.0-flash-001

# --- Groq ---
# VENTANILLA_BASE_URL=https://api.groq.com/openai/v1
# VENTANILLA_MODEL=llama-3.3-70b-versatile

# Port the local agent listens on.
PORT=8787
